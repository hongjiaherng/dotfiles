// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "terminal": {
    "font_family": "JetBrains Mono",
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "edit_predictions": {
    "mode": "eager",
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
    "provider": "copilot",
  },
  "cli_default_open_behavior": "new_window",
  "icon_theme": "Colored Zed Icons Theme Dark",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "relative_line_numbers": "enabled",
  "buffer_font_family": "JetBrains Mono",
  "vim_mode": true,
  "project_panel": {
    "dock": "right",
  },
  "ui_font_size": 13.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "Panda Light",
    "dark": "Ayu Dark",
  },
  "languages": {
    "Python": {
      "language_servers": [
        // Enable ty, ruff, disable basedpyright, pylsp, pyright
        "ty",
        "ruff",
        "!basedpyright",
        "!pylsp",
        "!pyright",
      ],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
  },
  "feature_flags": {
    "notebooks": "on",
    "tabular-data-preview": "on",
  },
}
