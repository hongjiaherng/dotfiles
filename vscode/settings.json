{
    "window.commandCenter": true,
    "editor.fontFamily": "JetBrains Mono, 'Courier New', monospace",
    "terminal.integrated.fontLigatures.enabled": true,
    "editor.fontLigatures": true,
    "workbench.sideBar.location": "right",
    "workbench.iconTheme": "catppuccin-mocha",
    "workbench.startupEditor": "none",
    "editor.minimap.enabled": false,
    "editor.lineNumbers": "relative",
    "vim.useSystemClipboard": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "explorer.confirmDelete": false,
    "redhat.telemetry.enabled": false,
    "makefile.configureOnOpen": true,
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "git.openRepositoryInParentFolders": "never",
    "[latex]": {
        "editor.defaultFormatter": "mathematic.vscode-latex"
    },
    "security.workspace.trust.untrustedFiles": "open",
    "files.associations": {
        "*.mdx": "markdown"
    },
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor"
    },
    "discord.removeDetails": true,
    "discord.removeLowerDetails": true,
    "rust-analyzer.cachePriming.enable": false,
    "gitlens.launchpad.indicator.enabled": false,
    "plantuml.render": "PlantUMLServer",
    "plantuml.server": "https://www.plantuml.com/plantuml",
    "claudeCode.preferredLocation": "panel",
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "markdown.preview.fontSize": 16,
    "markdown-preview-github-styles.colorTheme": "light",
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.fontSize": 15,
    "workbench.colorTheme": "One Dark Pro Night Flat",
    "python.analysis.typeCheckingMode": "standard",
    "search.useGlobalIgnoreFiles": true,
    "vim.handleKeys": {
        "<C-d>": true,
        "<C-s>": false,
        "<C-z>": false
    },
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<C-p>"
            ],
            "commands": [
                "workbench.action.quickOpen",
            ]
        },
    ],
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "remote.SSH.remotePlatform": {
        "194.68.245.152": "linux",
        "213.173.105.23": "linux",
        "195.26.233.80": "linux"
    },
    "git.blame.editorDecoration.enabled": true,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "files.autoSave": "afterDelay",
    "jupyter.askForKernelRestart": false,
    "terminal.integrated.commandsToSkipShell": [
        "-workbench.action.gotoLine",
        "-workbench.action.terminal.goToRecentDirectory"
    ],
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://ui.shadcn.com": true,
        "https://www.schemastore.org/": true
    },
    "terminal.integrated.gpuAcceleration": "off",
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "security.promptForLocalFileProtocolHandling": false,
    "chat.fontFamily": "Segoe UI",
    "chat.fontSize": 16,
    "vscord.status.details.text.debugging": "Debugging",
    "vscord.status.state.text.editing": "Working on ?{file_extension}",
    "vscord.status.state.text.viewing": "Viewing ?{file_extension}",
    "vscord.status.problems.text": "",
    "vscord.status.problems.enabled": false,
    "vscord.status.details.text.editing": "In {LANG}",
    "vscord.status.details.text.viewing": "In {LANG}",
    "vscord.status.state.text.debugging": "Debugging: {LANG}",
    "workbench.statusBar.visible": false
}